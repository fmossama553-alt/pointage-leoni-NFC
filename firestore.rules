rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ بدّل الإيميل بإيميل الأدمين بالضبط (اللي تدخل بيه)
    function admin() {
      return request.auth != null && request.auth.token.email == "oussamabaccouch29@gmail.com";
    }
    function isWorker() {
      return request.auth != null && request.auth.token.email.matches(".*@pointage.app");
    }
    function mat() {
      return request.auth.token.email.split("@")[0];
    }
    function myUid() {
      return get(/databases/$(database)/documents/accounts/$(mat())).data.uid;
    }

    // matricule -> uid
    match /accounts/{m} {
      allow read, write: if admin();
      allow get: if isWorker() && m == mat();
      // l'employé relie son matricule à la fiche qu'il a créée
      allow update: if isWorker() && m == mat()
                    && get(/databases/$(database)/documents/workers/$(request.resource.data.uid)).data.mat == m;
    }

    // matricules ouverts a l'inscription (cree par l'admin, lisible par tous, sans uid)
    match /claims/{m} {
      allow read, write: if admin();
      allow get: if true;
    }

    // fiche travailleur (contient le mot de passe: lisible seulement par l'admin et le travailleur lui-même)
    match /workers/{id} {
      allow read, write: if admin();
      allow get: if isWorker() && id == myUid();
      // l'employé crée sa fiche (avec sa carte) à la première connexion
      allow create: if isWorker() && request.resource.data.mat == mat()
                    && !exists(/databases/$(database)/documents/workers/$(id));
      allow delete: if isWorker() && id == myUid();
    }

    // pointages
    match /attendance/{id} {
      allow read, write: if admin();
      allow get: if isWorker() && id.matches(myUid() + "_.*");
      allow create: if isWorker() && id.matches(myUid() + "_.*")
                    && request.resource.data.uid == myUid();
      allow update: if isWorker() && id.matches(myUid() + "_.*")
                    && request.resource.data.uid == myUid()
                    && request.resource.data.in == resource.data.in;   // l'entrée ne se modifie plus
    }

    // justificatifs d'absence
    match /justifs/{id} {
      allow read, write: if admin();
      allow get: if isWorker() && id.matches(myUid() + "_.*");
      allow create, update: if isWorker() && id.matches(myUid() + "_.*")
                            && request.resource.data.uid == myUid();
    }

    // messagerie employé <-> admin (un document par message)
    match /chat/{id} {
      allow read, write: if admin();
      allow get: if isWorker() && id.matches(myUid() + "_.*");
      allow list: if isWorker() && resource.data.uid == myUid();
      allow create: if isWorker() && id.matches(myUid() + "_.*")
                    && request.resource.data.uid == myUid()
                    && request.resource.data.from == "worker";
    }

    // horaires / planning : admin seulement
    match /plan/{id} {
      allow read, write: if admin();
    }

    // config : position du site lisible par les employés, le reste admin
    match /config/site {
      allow write: if admin();
      allow get: if admin() || isWorker();
    }
    match /config/company {
      allow write: if admin();
      allow get: if admin() || isWorker();
    }
    match /config/shifts {
      allow write: if admin();
      allow get: if admin() || isWorker();
    }
    match /config/{d} {
      allow read, write: if admin();
    }
  }
}
